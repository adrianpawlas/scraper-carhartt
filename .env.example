# --- Required secrets (also set these in GitHub Actions secrets) ---

# Supabase project URL and service-role key (used for reading/writing public.products)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings ---
# Image + text embeddings use Google SigLIP (google/siglip-base-patch16-384), a FREE
# public model downloaded from the HuggingFace Hub and run locally. No API key needed.
#
# Optional: set HF_TOKEN if your network requires auth to download models from the Hub.
HF_TOKEN=

# Device to run the model on: auto | cpu | cuda | mps (default auto -> cuda/mps/cpu)
DEVICE=auto

# Override the HuggingFace model id (must be a 768-dim dual-encoder, e.g. SigLIP)
EMBEDDING_MODEL_ID=google/siglip-base-patch16-384

# --- Optional tuning ---

# Limit number of products to process this run (useful for dry runs). Empty = no limit.
SCRAPE_LIMIT=

# Seconds between consecutive store requests (respects robots.txt / rate limits)
REQUEST_DELAY_SECONDS=0.6

# Seconds between consecutive embedding calls (CPU-friendly; local model, so low is fine)
EMBEDDING_DELAY_SECONDS=0.1

# Concurrency for product page fetches (store-friendly)
FETCH_CONCURRENCY=4

# Only run discovery (crawl category pages) without hitting product pages / embeddings / DB writes
DRY_RUN=false